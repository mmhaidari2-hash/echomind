# Required on Vercel (Production + Preview). next.config.js rewrites
# /api/v1 and /api/v1/:path* to this Railway/Render host.
# Example Railway: https://echomind-api.up.railway.app/api/v1
# Example Render:  https://echomind-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://YOUR-API-HOST/api/v1
# Optional server-only rewrite overrides (same host, /api/v1 optional):
# API_PROXY_TARGET=https://echomind-api.up.railway.app
# RAILWAY_API_URL=https://echomind-api.up.railway.app
