{
  "appId": "com.echomind.assistant",
  "appName": "EchoMind Assistant",
  "webDir": "out",
  "backgroundColor": "#090A0F",
  "android": {
    "path": "android",
    "backgroundColor": "#090A0F",
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true,
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": true,
    "errorPath": "offline.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "launchAutoHide": true,
      "backgroundColor": "#090A0F",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090A0F"
    },
    "LocalNotifications": {
      "iconColor": "#E5A93C"
    }
  }
}
